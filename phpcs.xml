<?xml version="1.0"?>
<ruleset name="Prompt to Pattern">
    <description>WordPress Coding Standards for Prompt to Pattern</description>

    <file>./</file>
    <exclude-pattern>build/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>.opencode/*</exclude-pattern>
    <exclude-pattern>.codegraph/*</exclude-pattern>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.PHP.YodaConditions"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="prompt-to-pattern"/>
            </property>
        </properties>
    </rule>

    <rule ref="PHPCompatibilityWP"/>

    <config name="testVersion" value="8.1-"/>
    <config name="minimum_supported_wp_version" value="7.0"/>
</ruleset>
